<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Rede Wi-Fi dedicada usada pelo aplicativo quando o Windows não tiver nenhum Wi-Fi ativo.
         Se WifiSenha ficar vazio, o perfil é criado como rede aberta (sem senha). -->
    <add key="WifiSsid" value="NOME_DA_REDE" />
    <add key="WifiSenha" value="SENHA_DA_REDE" />
    <!-- Tempo máximo (segundos) aguardando a conexão ficar ativa. -->
    <add key="WifiTempoEsperaSegundos" value="30" />
    <!-- URL usada apenas para testar a conectividade ao servidor (exibe se conectou). -->
    <add key="UrlTesteConexao" value="https://app.edsbim.com/" />
    <add key="UrlTesteTimeoutSegundos" value="15" />
  </appSettings>
</configuration>
